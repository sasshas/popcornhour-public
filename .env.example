# Copy to .env (git-ignored) or set these in your container/compose environment.
# Never commit real values. "required" means the feature fails without it.

# --- Sign-in (single user) ---------------------------------------------------
# required: the password you type on the login page
APP_PASSWORD=
# required: random string used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Where the app is served ---------------------------------------------------
# Public base URL, no trailing slash. Used for the Trakt OAuth redirect URI
# (<PUBLIC_URL>/api/public/trakt/callback) and to decide whether cookies get the
# Secure flag (only when this starts with https://). Examples:
#   http://localhost:8080          (npm run dev)
#   http://192.168.1.10:3000       (Docker on the LAN)
#   https://movies.example.com     (behind an HTTPS reverse proxy)
PUBLIC_URL=http://localhost:8080

# --- TMDB (required for all browsing, search and artwork) -----------------------
# https://www.themoviedb.org/settings/api  (the v3 "API Key")
TMDB_API_KEY=

# --- OMDb (optional: IMDb / Rotten Tomatoes / Metascore ratings on detail pages) --
# https://www.omdbapi.com/apikey.aspx  (leave empty to hide those ratings)
OMDB_API_KEY=

# --- MDBList (optional: fills in the Rotten Tomatoes score when OMDb has none) -----
# OMDb has no Rotten Tomatoes entry for many recent releases. With a free key from
# https://mdblist.com (account preferences; 1,000 requests/day) those gaps are filled in.
# Leave empty to skip it. Answers are cached and refreshed automatically.
MDBLIST_API_KEY=

# --- Trakt (required for Connect Trakt and Import) ---------------------------------
# Create an app at https://trakt.tv/oauth/applications and register the redirect URI:
#   <PUBLIC_URL>/api/public/trakt/callback
TRAKT_CLIENT_ID=
# Only older Trakt apps have a Client Secret. Apps made since late 2026 show just a Client ID
# and sign in with PKCE: leave this empty for those and Popcornhour uses PKCE.
TRAKT_CLIENT_SECRET=

# --- WeTrakr (required for Connect WeTrakr and Import) -----------------------------
# Create an app in WeTrakr: Settings, API. The redirect URI can stay as it is
# (urn:ietf:wg:oauth:2.0:oob): sign-in uses a short code typed in at wetrakr.com/activate.
WETRAKR_CLIENT_ID=
WETRAKR_CLIENT_SECRET=

# --- Watch together (optional) -----------------------------------------------------
# The name of someone you watch with. The Favourite heart on each movie's and show's
# page is then replaced by a purple "<name> is interested" toggle that puts the title on
# (or takes it off) a list called "<name> is interested", made the first time it is
# used. Leave empty to keep the Favourite heart.
WATCH_TOGETHER_NAME=

# --- Cron ------------------------------------------------------------------------
# Protects POST /api/public/hooks/check-new-seasons. If empty the endpoint is
# disabled (503). Call it from cron with:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" <PUBLIC_URL>/api/public/hooks/check-new-seasons
CRON_SECRET=

# --- Release notifications (optional) ----------------------------------------------
# Once a day (9am Canberra time) Popcornhour checks your watchlist movies and sends what's
# new (on a US streaming service for the first time, US digital date, US cinema date) to
# this Home Assistant webhook as JSON { title, message, image, url, tag }. An automation
# with a Webhook trigger passes it to your phone. Settings > Notifications has a test button.
# e.g. http://192.168.1.20:8123/api/webhook/popcornhour-<random>. Empty = off.
HA_WEBHOOK_URL=

# --- Other apps adding to a list or marking watched (optional)--------------------------
# Lets another app on your network (Ultrahour, the disc tracker) add a title to one of your
# lists, take it off, or check whether it is on it (/api/public/lists/<list id>/items), and
# mark a movie watched (/api/public/watched). Give that app the same value (Ultrahour calls it
# POPCORNHOUR_TOKEN). If empty both endpoints are disabled (503). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LIST_API_TOKEN=

# --- Storage and server (all optional) --------------------------------------------
# SQLite file. Default: ./data/app.db in development, /data/app.db in production.
DB_PATH=
# Where backups are saved. Default: a "backups" folder beside the SQLite file (so /data/backups in Docker).
BACKUP_DIR=
# Built server (node .output/server/index.mjs) listens on these. Defaults: 3000 on all interfaces.
# The Docker image and docker-compose.yml fix them to 8080 / 0.0.0.0 / /data/app.db, so you only
# need these when running the built server directly (without Docker).
PORT=8080
HOST=0.0.0.0
